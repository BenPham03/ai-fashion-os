NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Persistence
DATABASE_URL=
REDIS_URL=

# AI
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=
AI_TIMEOUT_MS=60000
AI_MAX_RETRIES=2
AI_DAILY_BUDGET=

# Auth
JWT_SECRET=
JWT_EXPIRES_IN=1h

# TikTok / publishing
TIKTOK_CLIENT_ID=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=http://localhost:3000/api/v1/integrations/tiktok/callback

# Jobs
JOB_MAX_RETRIES=3
JOB_BACKOFF_MS=5000
