NODE_ENV=development
PORT=3000
LOG_LEVEL=info

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_fashion_os?schema=public
REDIS_URL=redis://localhost:6379

AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
AI_TIMEOUT_MS=60000
AI_MAX_RETRIES=2
AI_DAILY_BUDGET=10

JWT_SECRET=change-me-in-development
JWT_EXPIRES_IN=1h

TIKTOK_CLIENT_ID=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=http://localhost:3000/api/v1/integrations/tiktok/callback

JOB_MAX_RETRIES=3
JOB_BACKOFF_MS=5000
